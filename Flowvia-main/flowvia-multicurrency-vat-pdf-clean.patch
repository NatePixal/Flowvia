+    const labelX = 360;
+    const valX = 470;
+    const totalLine = (label: string, val: number, bold = false) => {
+      doc.font(bold ? 'Helvetica-Bold' : 'Helvetica').fontSize(10).text(label, labelX, ty, { width: 100 });
