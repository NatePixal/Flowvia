# Flowvia Firebase Configuration Template
# Copy this file to .env.local and replace the sample values with credentials from Firebase Console.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Provider-agnostic subscription payments
# Stripe is optional and should only be selected when the billing company is in a Stripe-supported country.
PAYMENT_PROVIDER=payme
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_SECRET_KEY
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to true only after Firebase billing is enabled, because scheduled functions require Cloud Scheduler.
ENABLE_SCHEDULED_SUBSCRIPTION_CHECK=false
