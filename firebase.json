{
  "apphosting": [
    {
      "backendId": "studio",
      "rootDir": ".",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "functions"],
      "alwaysDeployFromSource": true
    }
  ],
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json", "database": "(default)" }
}